# Public values: they are compiled into the browser bundle, so never put a secret here.
# Rebuild after changing any of them.

# Base URL of the FastAPI backend, without a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public origin of this site. Used for canonical URLs and social preview links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mapbox public token (starts with pk.). Restrict it to your site URLs in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.replace-me

# Firebase web app config (Firebase console > Project settings > Your apps). The API key is not a
# secret; access is enforced by Firebase Auth and by this project's backend.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=replace-me
